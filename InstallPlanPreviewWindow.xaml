<Window x:Class="NiumaLauncher.InstallPlanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装计划与目录确认"
        Width="820"
        Height="660"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#101318"
        Foreground="#F1F3F5"
        FontFamily="Microsoft YaHei">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="请核对版本、正式目录和备份位置。当前阶段仅确认计划，不执行安装"
                   FontSize="16"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="PlanTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,16"
                 Padding="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="#181C23"
                 Foreground="#F1F3F5"
                 BorderBrush="#2C333E"
                 FontSize="14"/>

        <StackPanel Grid.Row="2">
            <TextBlock Margin="0,0,0,12"
                       Foreground="#EEC48F"
                       TextWrapping="Wrap"
                       Text="整包更新会替换整个正式目录，不只是 EXE。存档、模组、截图等个人数据不会自动迁移。"/>

            <CheckBox x:Name="DirectoryScopeCheckBox"
                      Margin="0,0,0,16"
                      IsChecked="False"
                      IsThreeState="False"
                      Foreground="#F1F3F5">
                <TextBlock TextWrapping="Wrap"
                           Text="我确认上方正式目录是独立游戏发布目录，不是源码或其他文件目录，也不包含需要保留或迁移的个人数据。"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="取消"
                        Margin="0,0,12,0"
                        Padding="24,10"
                        IsCancel="True"/>

                <Button Content="确认本次计划"
                        Padding="24,10"
                        Background="#C7F36B"
                        Foreground="#11151B"
                        IsDefault="False"
                        IsEnabled="{Binding ElementName=DirectoryScopeCheckBox,
                                    Path=IsChecked,
                                    Mode=OneWay,
                                    FallbackValue=False,
                                    TargetNullValue=False}"
                        Click="ConfirmPlanButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>