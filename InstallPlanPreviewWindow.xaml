<Window x:Class="NiumaLauncher.InstallPlanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装计划（只读）"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#101318"
        Foreground="#F1F3F5"
        FontFamily="Microsoft YaHei">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="请核对目标版本和目录。本窗口仅预览，关闭后不会执行安装。"
                   FontSize="16"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="PlanTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,16"
                 Padding="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="#181C23"
                 Foreground="#F1F3F5"
                 BorderBrush="#2C333E"
                 FontSize="14"/>

        <Button Grid.Row="2"
                Content="关闭预览"
                HorizontalAlignment="Right"
                Padding="24,10"
                Background="#C7F36B"
                Foreground="#11151B"
                IsCancel="True"/>
    </Grid>
</Window>