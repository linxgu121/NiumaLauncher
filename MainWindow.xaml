<Window x:Class="NiumaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niuma Launcher"
        Width="1080" Height="680"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#101318"
        Foreground="#F1F3F5"
        FontFamily="Microsoft YaHei">

    <Window.Resources>
        <!-- 统一按钮外观，后面的按钮可以覆盖背景和文字颜色。 -->
        <Style x:Key="LauncherButton" TargetType="Button">
            <Setter Property="Background" Value="#C7F36B"/>
            <Setter Property="Foreground" Value="#17200D"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 左栏固定宽度；右栏的 * 表示使用剩余空间。 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#181C23"
                Padding="24,32">
            <StackPanel>
                <TextBlock Text="NIUMA"
                           FontSize="25"
                           FontWeight="Bold"/>

                <TextBlock Text="GAME LAUNCHER"
                           Margin="0,6,0,40"
                           FontSize="10"
                           Foreground="#8F98A6"/>

                <Border Background="#293323"
                        CornerRadius="8"
                        Padding="16,14">
                    <TextBlock Text="我的游戏"
                               Foreground="#C7F36B"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <!-- Auto 按内容决定高度，中间区域填满剩余空间。 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="游戏库"
                       FontSize="18"
                       Margin="0,0,0,24"/>

            <!-- 后续可以在这个区域加入游戏封面和公告。 -->
            <Border Grid.Row="1"
                    CornerRadius="14"
                    Padding="32"
                    Margin="0,0,0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#344737" Offset="0"/>
                        <GradientStop Color="#1B2631" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="NIUMA PROJECT"
                               FontSize="13"
                               Foreground="#C7F36B"/>
                    <TextBlock Text="我的游戏"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,10,0,12"/>
                    <TextBlock Text="选择本地游戏，开始你的冒险。"
                               FontSize="15"
                               Foreground="#C2CBD3"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock Text="游戏程序"
                           Foreground="#8F98A6"
                           Margin="0,0,0,6"/>

                <TextBlock Text="{Binding GameExecutablePath}"
                           ToolTip="{Binding GameExecutablePath}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,12"/>

                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="#C7F36B"
                           Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="选择游戏程序"
                            Style="{StaticResource LauncherButton}"
                            Background="#2C333E"
                            Foreground="#F1F3F5"
                            Margin="0,0,12,0"
                            IsEnabled="{Binding CanSelectGame}"
                            Click="SelectGameButton_Click"/>

                    <Button Content="{Binding LaunchButtonText}"
                            Style="{StaticResource LauncherButton}"
                            MinWidth="180"
                            IsEnabled="{Binding CanLaunch}"
                            Click="LaunchGameButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>